# Network & Server Bindings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501

# MySQL Database Configuration
# If MySQL connection fails, system automatically falls back to local SQLite (ai_chatbot.db)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_smart_chatbot
DB_POOL_SIZE=5

# AI Provider Configuration
# Supported options: mock, gemini, openai
LLM_PROVIDER=mock
VISION_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock

# External API Keys (Required only if provider is set to gemini or openai)
GEMINI_API_KEY=
OPENAI_API_KEY=

# RAG & Document Ingestion
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_MIN_SCORE=0.1
MAX_UPLOAD_SIZE_MB=10

# Privacy & Security
ENABLE_CONVERSATION_PERSISTENCE=false
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
